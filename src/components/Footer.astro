---
import Logo from './Logo.astro';
import Newsletter from './Newsletter.astro';
import { brand, contact, live } from '../data/site';
import { u } from '../lib/url';

const cols = [
  {
    title: 'اعمل مع يحيى',
    links: [
      { label: 'الاستشارات', href: '/consultations/' },
      { label: 'احجز استشارتك', href: '/booking-app/' },
      { label: 'البرامج والورش', href: '/programs/' },
      { label: 'رفيق الوعي', href: '/programs/#community' },
    ],
  },
  {
    title: 'المحتوى',
    links: [
      { label: 'كل المقالات', href: '/articles/' },
      { label: 'التربية', href: '/التربية/' },
      { label: 'العلاقات', href: '/العلاقات/' },
      { label: 'تطوير الذات', href: '/تطوير-الذات/' },
    ],
  },
  {
    title: 'عن يحيى',
    links: [
      { label: 'قصة يحيى', href: '/about-us/' },
      { label: 'تجارب العملاء', href: '/ourreviwe/' },
      { label: 'تواصل معنا', href: '/contact-us/' },
      { label: 'الشروط والأحكام', href: live.terms, external: true },
    ],
  },
];
const year = new Date().getFullYear();
const isPreview = import.meta.env.PUBLIC_SITE_ENV === 'preview';
---

<footer class="site-footer surface-night on-night">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo />
        <p class="site-footer__quote">{brand.message}</p>
      </div>
      <div class="site-footer__news">
        <h2 class="site-footer__news-title">كن أول من يعرف كل جديد</h2>
        <p class="muted small">مقالات، ورش، وبرامج جديدة من يحيى فؤاد — مباشرة في بريدك.</p>
        <Newsletter tone="night" source="footer" />
      </div>
    </div>

    <div class="site-footer__grid">
      {cols.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="site-footer__h">{col.title}</h2>
          <ul role="list">
            {col.links.map((l) => (
              <li><a href={l.external ? l.href : u(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
      <div>
        <h2 class="site-footer__h">تواصل</h2>
        <ul role="list">
          <li><a href={`mailto:${contact.email}`} class="en">{contact.email}</a></li>
          <li><a href={`tel:${contact.phoneIntl}`} class="en">{contact.phoneDisplay}</a></li>
          <li class="muted">{contact.locationAr}</li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="caption muted">
        المحتوى هنا فكر وتأمل، وليس علاجًا نفسيًا ولا وصفة دوائية ولا فتوى.
      </p>
      <p class="caption muted">
        © <span class="num">{year}</span> يحيى فؤاد — {brand.community}
        {isPreview && <span class="preview-note"> · نسخة معاينة للتصميم الجديد</span>}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--s-9) var(--s-6); }
  .site-footer__top {
    display: grid; gap: var(--s-7); padding-block-end: var(--s-8);
    border-bottom: 1px solid var(--night-line);
  }
  .site-footer__quote {
    margin-block-start: var(--s-5); font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.9rem); line-height: 1.3; max-width: 16ch; color: var(--on-night);
  }
  .site-footer__news-title { font-size: var(--fs-h3); margin-block-end: var(--s-2); }
  .site-footer__grid {
    display: grid; gap: var(--s-6); grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: var(--s-7);
  }
  .site-footer__h { font-family: var(--font-body); font-size: var(--fs-caption); font-weight: 500; color: var(--sand-on-night); margin-block-end: var(--s-3); }
  .site-footer ul { list-style: none; padding: 0; display: grid; gap: var(--s-1); }
  .site-footer li a { display: inline-flex; min-height: 40px; align-items: center; text-decoration: none; color: var(--on-night); opacity: 0.85; }
  .site-footer li a:hover { opacity: 1; text-decoration: underline; }
  .site-footer__bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3);
    padding-block-start: var(--s-5); border-top: 1px solid var(--night-line);
  }
  .preview-note { color: var(--sand-on-night); }
  @media (min-width: 900px) {
    .site-footer__top { grid-template-columns: 1.2fr 1fr; align-items: end; }
    .site-footer__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
