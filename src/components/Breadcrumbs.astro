---
/** Visible breadcrumbs + BreadcrumbList JSON-LD. */
import { u, abs } from '../lib/url';
interface Props { items: { label: string; href?: string }[]; tone?: 'paper' | 'night' }
const { items, tone = 'paper' } = Astro.props;
const all = [{ label: 'الرئيسية', href: '/' }, ...items];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: abs(it.href, Astro.site) } : {}),
  })),
};
---
<nav class:list={['crumbs', tone === 'night' && 'crumbs--night']} aria-label="مسار التنقل">
  <ol role="list">
    {all.map((it, i) => (
      <li>
        {it.href && i < all.length - 1 ? <a href={u(it.href)}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4em; list-style: none; padding: 0; font-size: var(--fs-caption); color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.4em; opacity: 0.5; }
  .crumbs a { text-decoration: none; display: inline-block; padding-block: 0.4em; }
  .crumbs a:hover { text-decoration: underline; color: var(--ink); }
  .crumbs--night { color: var(--on-night-muted); }
  .crumbs--night ol { color: var(--on-night-muted); }
  .crumbs--night a:hover { color: var(--on-night); }
</style>
