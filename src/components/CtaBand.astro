---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { u } from '../lib/url';
interface Props {
  title: string;
  text?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  id?: string;
}
const {
  title,
  text,
  image,
  imageAlt = '',
  primary = { label: 'احجز استشارتك', href: '/booking-app/' },
  secondary = { label: 'اكتشف البرامج', href: '/programs/' },
  id = 'final-cta',
} = Astro.props;
---
<section class="cta-band surface-night on-night" aria-labelledby={id}>
  <div class="container cta-band__grid">
    <div class="cta-band__text" data-reveal>
      <h2 id={id} class="cta-band__title" set:html={title} />
      {text && <p class="lead muted cta-band__lede">{text}</p>}
      <div class="cta-band__actions">
        <a href={u(primary.href)} class="btn btn--light" data-track="cta_book" data-track-loc="final_cta">{primary.label} <span class="arrow" aria-hidden="true">←</span></a>
        <a href={u(secondary.href)} class="btn btn--ghost-light" data-track="cta_secondary" data-track-loc="final_cta">{secondary.label}</a>
      </div>
      <slot />
    </div>
    {image && (
      <div class="cta-band__media fill blend-edges" data-reveal style="--delay:120ms">
        <Picture src={image} alt={imageAlt} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(min-width: 1024px) 38vw, 90vw" loading="lazy" />
      </div>
    )}
  </div>
</section>
<style>
  .cta-band { overflow: hidden; }
  .cta-band__grid { display: grid; gap: var(--s-7); align-items: center; padding-block: var(--section) 0; }
  .cta-band__text { padding-block-end: var(--s-4); }
  .cta-band__title { font-size: var(--fs-display); line-height: var(--lh-display); max-width: 12ch; }
  .cta-band__lede { margin-block-start: var(--s-5); max-width: 34rem; }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-block-start: var(--s-6); }
  .cta-band__media { overflow: hidden; align-self: end; aspect-ratio: 4 / 5; max-height: 640px; --fade-x: 20%; --fade-t: 10%; }
  .cta-band__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  @media (min-width: 900px) {
    .cta-band__grid { grid-template-columns: 1.15fr 0.85fr; }
    .cta-band__text { padding-block-end: var(--section); }
  }
  @media (max-width: 520px) { .cta-band__actions .btn { flex: 1 1 100%; } }
</style>
