---
/**
 * Static redirect for legacy WordPress URLs (static hosts can't send 301s).
 * On WordPress / a real server, prefer the server-side 301s in docs/REDIRECTS.md.
 */
import { u, abs } from '../lib/url';
interface Props { to: string; title?: string }
const { to, title = 'تم نقل الصفحة' } = Astro.props;
const target = u(to);
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={abs(to, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{title} — تابع إلى الصفحة الجديدة</a></p>
  </body>
</html>
